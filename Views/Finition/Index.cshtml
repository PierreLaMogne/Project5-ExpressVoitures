@using Net_P5.ViewModels
@model FinitionViewModel
@using Net_P5.Data


@{
    ViewData["Title"] = "Modifier ou supprimer une finition";
}

<div class="container">
    <div class="row justify-content-center align-content-center mb-5">
        <div class="col-4">
            <div class="mb-5">
                <h1 class="titre mb-2">Modifier ou supprimer une finition</h1>
            </div>
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger" role="alert">
                    @TempData["ErrorMessage"]
                </div>
            }

            <div class="mb-3 d-flex flex-column align-items-center">
                <label for="itemSelect" class="form-label">
                    Sélectionner une finition
                        <select id="itemSelect" class="form-select border-dark" required>
                            <option value="" disabled selected>Sélectionner une finition</option>
                            @foreach (var finition in ViewBag.Finitions)
                            {
                                <option value="@finition.Id" data-modele-id="@finition.ModeleId">@finition.Modele.Nom @finition.Nom</option>
                            }
                        </select>
                    <span class="text-danger" id="validationItem"></span>
                </label>
            </div>
            <input type="hidden" id="selectedId" value="" />

            <div class="d-flex justify-content-center gap-3 mb-3">
                <a class="btn btn-modifier" href="#" role="button" data-bs-toggle="modal" data-bs-target="#ConfirmerModification"
                   aria-label="Modifier l'élément sélectionné" style="pointer-events: none; opacity: 0.6;" id="btnModifier">
                    Modifier
                </a>
                <a class="btn btn-supprimer" href="#" role="button" data-bs-toggle="modal" data-bs-target="#ConfirmerSuppression"
                   aria-label="Supprimer l'élément sélectionné" style="pointer-events: none; opacity: 0.6;" id="btnSupprimer">
                    Supprimer
                </a>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="ConfirmerModification" tabindex="-1" aria-labelledby="ModalSuppression" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-title fs-5" id="ModalSuppression">Indiquer les nouvelles informations</div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row d-flex justify-content-center">
                    <form asp-controller="Finition" asp-action="Edit" asp-route-id="" method="post" id="formModification">
                        <input type="hidden" asp-for="FinitionId" id="modalModificationId" />
                        <div class="mb-3">
                            <label asp-for="FinitionNom" class="form-label">Nouveau nom de la finition</label>
                            <input asp-for="FinitionNom" class="form-control border-dark" id="modalModificationNom">
                            <span asp-validation-for="FinitionNom" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">À quel modèle appartient cette finition ?</label>
                            <div class="d-flex flex-column flex-lg-row">
                                <select asp-for="ModeleId" class="form-select border-dark mb-2 mb-md-0 flex-md-grow-1" id="modalModificationModeleId" required style="border-top-right-radius: 0.375rem; border-bottom-right-radius: 0.375rem;">
                                    <option value="" disabled selected>Sélectionnez un modèle</option>
                                    @foreach (var modele in ViewBag.Modeles)
                                    {
                                        <option value="@modele.Id">@modele.Nom</option>
                                    }
                                </select>
                            </div>
                            <span asp-validation-for="ModeleId" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">Modifier</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ConfirmerSuppression" tabindex="-1" aria-labelledby="ModalSuppression" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-title fs-5" id="ModalSuppression">Confirmer la suppression ?</div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row d-flex justify-content-center">
                    <form asp-controller="Finition" asp-action="Delete" method="post">
                        <input type="hidden" id="modalSupprId" name="Id" value="" />
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary">Oui, supprimer</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<!--Récupérer la valeur SelectedId-->
<script>
    $(document).ready(function(){
        function toggleButtons(enable) {
            const style = enable ? {'pointer-events': 'auto', 'opacity': '1'} : {'pointer-events': 'none', 'opacity': '0.6'};
            $('#btnModifier, #btnSupprimer').css(style);
        }

        function updateFields(id, nom, modeleId) {
            $('#selectedId, #modalModificationId, #modalSupprId').val(id);
            $('#modalModificationNom').val(nom);
            $('#modalModificationModeleId').val(modeleId);
            $('#formModification').attr('action', id ? `/Finition/Edit/${id}` : '');
        }

        $('#itemSelect').change(function(){
            const selectedId = $(this).val();

            if(selectedId){
                const selectedOption = $(this).find('option:selected');
                $('#validationItem').text('');
                updateFields(selectedId, selectedOption.text(), selectedOption.data('modele-id'));
                toggleButtons(true);
            } else {
                $('#validationItem').text('Veuillez sélectionner un modèle.');
                updateFields('', '', '');
                toggleButtons(false);
            }
        });
    });
</script>
}