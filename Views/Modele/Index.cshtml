@using Net_P5.ViewModels
@model ModeleViewModel
@using Net_P5.Data


@{
    ViewData["Title"] = "Modifier ou supprimer un modèle";
}

<div class="container">
    <div class="row justify-content-center align-content-center mb-5">
        <div class="col-4">
            <div class="mb-5">
                <h1 class="titre">Modifier ou supprimer un modèle</h1>
            </div>
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger" role="alert">
                    @TempData["ErrorMessage"]
                </div>
            }

            <div class="mb-3 d-flex flex-column align-items-center">
                <label for="itemSelect" class="form-label">
                    Sélectionner un modèle
                    <select id="itemSelect" class="form-select border-dark w-100" required>
                            <option value="" disabled selected>Sélectionner un modèle</option>
                            @foreach (var modele in ViewBag.Modeles)
                            {
                                <option value="@modele.Id" data-marque-id="@modele.MarqueId">@modele.Nom</option>
                            }
                        </select>
                    <span class="text-danger" id="validationItem"></span>
                </label>
            </div>
            <input type="hidden" id="selectedId" value="" />

            <div class="d-flex justify-content-center gap-3 mb-3">
                <a class="btn btn-modifier" href="#" role="button" data-bs-toggle="modal" data-bs-target="#ConfirmerModification"
                   aria-label="Modifier l'élément sélectionné" style="pointer-events: none; opacity: 0.6;" id="btnModifier">
                    Modifier
                </a>
                <a class="btn btn-supprimer" href="#" role="button" data-bs-toggle="modal" data-bs-target="#ConfirmerSuppression"
                   aria-label="Supprimer l'élément sélectionné" style="pointer-events: none; opacity: 0.6;" id="btnSupprimer">
                    Supprimer
                </a>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="ConfirmerModification" tabindex="-1" aria-labelledby="ModalSuppression" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-title fs-5" id="ModalSuppression">Indiquer les nouvelles informations</div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row d-flex justify-content-center">
                    <form asp-controller="Modele" asp-action="Edit" asp-route-id="" method="post" id="formModification">
                        <input type="hidden" asp-for="ModeleId" id="modalModificationId" />
                        <div class="mb-3">
                            <label asp-for="ModeleNom" class="form-label">Nouveau nom du modèle</label>
                            <input asp-for="ModeleNom" class="form-control border-dark" id="modalModificationNom">
                            <span asp-validation-for="ModeleNom" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">À quelle marque appartient ce modèle ?</label>
                            <div class="d-flex flex-column flex-lg-row">
                                <select asp-for="MarqueId" class="form-select border-dark mb-2 mb-md-0 flex-md-grow-1" id="modalModificationMarqueId" required style="border-top-right-radius: 0.375rem; border-bottom-right-radius: 0.375rem;">
                                    <option value="" disabled selected>Sélectionnez une marque</option>
                                    @foreach (var marque in ViewBag.Marques)
                                    {
                                        <option value="@marque.Id">@marque.Nom</option>
                                    }
                                </select>
                            </div>
                            <span asp-validation-for="MarqueId" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">Modifier</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ConfirmerSuppression" tabindex="-1" aria-labelledby="ModalSuppression" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-title fs-5" id="ModalSuppression">Confirmer la suppression ?</div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row d-flex justify-content-center">
                    <form asp-controller="Modele" asp-action="Delete" method="post">
                        <input type="hidden" id="modalSupprId" name="Id" value="" />
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary">Oui, supprimer</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <!--Récupérer la valeur SelectedId-->
    <script>
        $(document).ready(function(){
            function toggleButtons(enable) {
                const style = enable ? {'pointer-events': 'auto', 'opacity': '1'} : {'pointer-events': 'none', 'opacity': '0.6'};
                $('#btnModifier, #btnSupprimer').css(style);
            }

            function updateFields(id, nom, marqueId) {
                $('#selectedId, #modalModificationId, #modalSupprId').val(id);
                $('#modalModificationNom').val(nom);
                $('#modalModificationMarqueId').val(marqueId);
                $('#formModification').attr('action', id ? `/Modele/Edit/${id}` : '');
            }

            $('#itemSelect').change(function(){
                const selectedId = $(this).val();
                
                if(selectedId){
                    const selectedOption = $(this).find('option:selected');
                    $('#validationItem').text('');
                    updateFields(selectedId, selectedOption.text(), selectedOption.data('marque-id'));
                    toggleButtons(true);
                } else {
                    $('#validationItem').text('Veuillez sélectionner une marque.');
                    updateFields('', '', '');
                    toggleButtons(false);
                }
            });
        });
    </script>
}